FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ParkAtBlock.csproj .
RUN dotnet restore ParkAtBlock.csproj

COPY . .
RUN dotnet publish ParkAtBlock.csproj \
    --configuration Release \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Production
ENV Hosting__BehindTlsProxy=true
COPY --from=build /app/publish .

EXPOSE 8080
ENTRYPOINT ["sh", "-c", "dotnet ParkAtBlock.dll --urls http://0.0.0.0:${PORT:-8080}"]