{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix ParkAtBlock.UI",
  "buildCommand": "npm --prefix ParkAtBlock.UI run build",
  "outputDirectory": "ParkAtBlock.UI/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}